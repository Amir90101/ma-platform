# Скопируйте в .env.local и заполните. .env.local не коммитится.

# --- Supabase ---
# Локально: значения печатает `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только для серверного кода Next.js (Route Handlers, Server Actions).
# Никогда не добавляйте префикс NEXT_PUBLIC_ и не используйте в клиентских компонентах.
SUPABASE_SERVICE_ROLE_KEY=

# --- Приложение ---
# Публичный адрес, из него строятся ссылки /{slug} и /b/{token}
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Turnstile (защита публичной формы брони) ---
# Тестовые ключи Cloudflare, которые всегда проходят проверку, подходят для локальной разработки
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Лимиты публичной брони ---
# Сколько будущих онлайн-броней может быть одновременно в одном заведении
# на один телефон и на один IP
PUBLIC_BOOKING_MAX_ACTIVE_PER_PHONE=2
PUBLIC_BOOKING_MAX_ACTIVE_PER_IP=5

# --- Мониторинг (Sentry) ---
# Без DSN Sentry выключен. Телефоны гостей и токены ссылок /b/... вычищаются
# перед отправкой (src/lib/sentry-scrub.ts).
# DSN проекта для сервера и для браузера (одинаковые значения)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# production, staging и т. п.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# 1 — включает /api/sentry-check, который бросает тестовую ошибку
SENTRY_CHECK_ENABLED=
